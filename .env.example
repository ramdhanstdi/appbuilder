# =============================================================================
# AppBuilder configuration. Copy this file to `.env` and fill in real values:
#     cp .env.example .env
# `.env` is gitignored — never commit real credentials.
# =============================================================================

# --- Shared defaults (inherited by every agent) ------------------------------
# OpenAI-compatible base URL.
AGENTS_API_BASE=http://localhost:20128/v1
# API key. REQUIRED — the server refuses to start if no key resolves for an agent.
AGENTS_API_KEY=your-api-key-here
# Model name served by the endpoint above.
AGENTS_MODEL=your-model-name
# Sampling temperature.
AGENTS_TEMPERATURE=0.1

# --- Orchestration -----------------------------------------------------------
# Workspace root where generated apps are written.
PM_WORKSPACE=./workspace
# Max delegations (assign_task) allowed per user request.
MAX_ASSIGN_TASKS=12
# Max messages retained in a specialist's conversation history before trimming.
MAX_HISTORY_MESSAGES=60
# Response language used before anything confident is detected from the user's message
# (ISO 639-1). Human-facing prose follows the user's language; code, file names, and
# protocol tokens are always English.
DEFAULT_RESPONSE_LANGUAGE=id

# --- Command sandbox ---------------------------------------------------------
# Agent shell commands run in a disposable container by default: only the session
# workspace is mounted, no outbound network, capped memory, non-root user.
# Set to true ONLY for local development without Docker — it restores arbitrary
# shell execution as your own user.
# ALLOW_UNSANDBOXED_COMMANDS=false
# Image used to execute commands (build: docker build -f Dockerfile.runner -t appbuilder-runner:latest .)
# RUNNER_IMAGE=appbuilder-runner:latest
# 'none' keeps loopback (QA smoke tests work) but blocks outbound access.
# Use 'bridge' when a task genuinely needs to install packages.
# RUNNER_NETWORK=none
# RUNNER_MEMORY=512m
# RUNNER_CPUS=2
# RUNNER_USER=1000:1000
# Set only when the server itself runs in a container (docker-compose sets it).
# RUNNER_VOLUMES_FROM=appbuilder

# --- Metrics -----------------------------------------------------------------
# Directory for per-request JSON Lines metrics records (one file per session).
# RUNS_DIR=./runs
# Optional price list override, USD per 1M tokens. Models absent from the list still
# have their tokens counted; they just contribute no estimated cost.
# MODEL_PRICING_JSON={"my-model": {"input": 0.5, "output": 1.5}}

# --- Per-agent overrides (optional) ------------------------------------------
# Every agent inherits the AGENTS_* values above. Override any single agent with
# its prefix — PM_, BA_, FRONTEND_, BACKEND_, QA_ — without touching the others.
# Example: a strong model for architecture, a cheap model for mechanical review.
#
# BA_API_BASE=https://api.anthropic.com/v1
# BA_API_KEY=<your-anthropic-api-key>
# BA_MODEL=claude-sonnet-5
# BA_TEMPERATURE=0.1
#
# QA_MODEL=gpt-4o-mini
